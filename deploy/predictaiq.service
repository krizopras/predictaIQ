[Unit]
Description=PredictaIQ Flask application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/predictaiq
Environment="PATH=/opt/predictaiq/.venv/bin"
ExecStart=/opt/predictaiq/.venv/bin/gunicorn backend.server:app --bind 127.0.0.1:8000 --workers 2 --threads 2 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
